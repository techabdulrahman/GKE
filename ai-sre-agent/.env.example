# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub: fine-grained token with "Actions: read" on the repo
GITHUB_TOKEN=
GITHUB_REPO=techabdulrahman/gcpkubernetes
GITHUB_WORKFLOW=deploy.yml

# Grafana (Grafana Cloud or self-hosted): service account token, Viewer role is enough
GRAFANA_URL=https://YOURSTACK.grafana.net
GRAFANA_TOKEN=
# Optional: Prometheus datasource UID for the extra PromQL checks
GRAFANA_PROM_UID=

# Kubernetes target
K8S_NAMESPACE=ai-troubleshooter
K8S_DEPLOYMENT=ai-k8s-demo
